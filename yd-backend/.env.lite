# ===== YD 家居 — Lite 开发模式（SQLite，无 MySQL/Redis 依赖）=====
# 用途：开发演示、CI 验证、单机本地起后端

# 应用
APP_NAME=YD Furniture API (Lite)
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库（SQLite 模式）
DB_TYPE=sqlite
DB_PATH=./yd_lite.db

# Redis（Lite 模式：不实际使用）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET=lite-dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=120

# 验证码
CAPTCHA_EXPIRE_SECONDS=300
CAPTCHA_MAX_FAILED_ATTEMPTS=5
CAPTCHA_LOCK_MINUTES=15

# CORS
CORS_ORIGINS=*
